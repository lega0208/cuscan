+        UmapError::Numerical(format!("could not read layout edges: {error}"))
+    })?;
+    let weights = weights.to_data().try_to_vec::<f32>().map_err(|error| {
+        UmapError::Numerical(format!("could not read layout weights: {error}"))
+    })?;
+    let mut offsets = vec![0i32; rows + 1];
+    for (&row, &weight) in endpoints.iter().zip(&weights) {
